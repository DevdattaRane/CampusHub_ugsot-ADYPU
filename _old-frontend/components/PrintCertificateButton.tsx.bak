'use client';

export default function PrintCertificateButton() {
  function handlePrint() {
    window.print();
  }

  return (
    <button
      type="button"
      onClick={handlePrint}
      className="btn btn--primary"
      style={{ display: 'inline-flex', alignItems: 'center', gap: 6 }}
    >
      <span>🖨️</span> Print / Save PDF
    </button>
  );
}
